--- !u!114 &495929634
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 495929630}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: fb56e0697516c8445a2f7536c2790f5a, type: 3}
    m_FontSize: 36
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>\u4E00\u3001 \u5B9E\u9A8C\u76EE\u7684</b>\r\n     \u672C\u5B9E\u9A8C\u65E8\u5728\u52A0\u6DF1\u5BF9\u6676\u4F53\u7535\u5149\u6548\u5E94\u539F\u7406\u7684\u7406\u89E3\uFF0C\u638C\u63E1\u7535\u5149\u6676\u4F53\u534A\u6CE2\u7535\u538B\u7684\u6D4B\u91CF\u65B9\u6CD5\uFF0C\u4E86\u89E3\u7535\u5149\u8C03\u5236\u7684\u57FA\u672C\u5DE5\u4F5C\u539F\u7406\u53CA\u5E94\u7528\u3002\u5E76\u901A\u8FC7\u5206\u6790\u7535\u5149\u6548\u5E94\u73B0\u8C61\uFF0C\u7814\u7A76\u5916\u52A0\u7535\u573A\u5BF9\u5149\u6CE2\u76F8\u4F4D\u4E0E\u504F\u632F\u6001\u7684\u5F71\u54CD\u3002\r\n\r\n<b>\u4E8C\u3001
    \u5B9E\u9A8C\u539F\u7406\u8BF4\u660E</b>\r\n\n\u67D0\u4E9B\u5404\u5411\u540C\u6027\u4ECB\u8D28\u6216\u4E2D\u5FC3\u5BF9\u79F0\u7684\u6676\u4F53\uFF0C\u5728\u5916\u52A0\u7535\u573A\u4F5C\u7528\u4E0B\u4F1A\u4EA7\u751F\u5149\u5B66\u5404\u5411\u5F02\u6027\uFF0C\u8FD9\u79CD\u6298\u5C04\u7387\u968F\u5916\u52A0\u7535\u573A\u53D8\u5316\u7684\u73B0\u8C61\u79F0\u4E3A\u7535\u5149\u6548\u5E94\u3002\u672C\u5B9E\u9A8C\u4E3B\u8981\u7814\u7A76\u7EBF\u6027\u7535\u5149\u6548\u5E94\uFF08\u666E\u514B\u5C14\u65AF\u6548\u5E94\uFF09\u3002\u5F53\u504F\u632F\u5149\u901A\u8FC7\u7F6E\u4E8E\u7535\u573A\u4E2D\u7684\u7535\u5149\u6676\u4F53\uFF08\u5982\u94CC\u9178\u9502LiNbO3\uFF09\u65F6\uFF0C\u4E24\u6B63\u4EA4\u504F\u632F\u5206\u91CF\u4E4B\u95F4\u4F1A\u4EA7\u751F\u4E0E\u5916\u52A0\u7535\u538B\u6210\u6B63\u6BD4\u7684\u76F8\u4F4D\u5DEE
    <b>\u0394\u03C6</b>\u3002\u76F8\u4F4D\u5DEE\u8FBE\u5230\u03C0\u65F6\u6240\u9700\u65BD\u52A0\u7684\u7535\u538B\u79F0\u4E3A\u534A\u6CE2\u7535\u538B<b>V\u03C0</b>\uFF0C\u5B83\u662F\u8861\u91CF\u6676\u4F53\u7535\u5149\u6027\u80FD\u7684\u91CD\u8981\u53C2\u6570\u3002\n\u900F\u5C04\u5149\u5F3A\u4E0E\u5916\u52A0\u7535\u538B\u7684\u5173\u7CFB\u5448\u6B63\u5F26\u5E73\u65B9\u89C4\u5F8B\u3002\r\n\r\n<b>\u4E09\u3001
    \u5B9E\u9A8C\u8BBE\u5907</b>\r\n\n\u6FC0\u5149\u5668\u3001\u504F\u632F\u7247\u3001\u5149\u7535\u63A2\u6D4B\u5668\u3001\u7535\u5149\u6676\u4F53\u3001\u76F4\u6D41\u7535\u6E90\u3001\u4EA4\u6D41\u4FE1\u53F7\u53D1\u751F\u5668\u3001\u53CC\u8E2A\u793A\u6CE2\u5668\u3001\u6269\u675F\u955C\u3001\u5149\u5B66\u5BFC\u8F68\u3002\r\n\r\n<b>\u56DB\u3001
    \u5B9E\u9A8C\u6B65\u9AA4</b>\r\n\r\n<b>1. \u4EEA\u5668\u8C03\u8282</b>\r\n1\uFF09\u6253\u5F00\u6FC0\u5149\uFF0C\u653E\u7F6E\u767D\u5C4F\u4E8E\u5BFC\u8F68\u4E0A\u7531\u8FD1\u53CA\u8FDC\u79FB\u52A8\u767D\u5C4F\uFF0C\u8C03\u8282\u6FC0\u5149\u5668\u7684\u9AD8\u5EA6\u548C\u5DE6\u53F3\u4F4D\u7F6E\uFF0C\u4F7F\u5149\u70B9\u5728\u767D\u5C4F\u4E0A\u7684\u4F4D\u7F6E\u4E0D\u53D8\u4E14\u4F4D\u4E8E\u6C34\u5E73\u4E2D\u5FC3\u3002\r\n2\uFF09\u5C06\u504F\u632F\u7247
    P \u653E\u5728\u6FC0\u5149\u5668\u4E0E\u5149\u7535\u63A5\u6536\u88C5\u7F6E\u4E4B\u95F4\uFF0C\u767D\u5C4F\u653E\u7F6E\u4E8E
    P \u4E4B\u540E\uFF0C\u65CB\u8F6C\u504F\u632F\u7247\uFF0C\u5F53\u5149\u70B9\u5149\u5F3A\u6700\u5F31\u65F6\uFF0C\u6B64\u65F6\u504F\u632F\u65B9\u5411\u4E0E\u6FC0\u5149\u504F\u632F\u65B9\u5411\u76F8\u5782\u76F4\uFF0C\u5C06
    P \u4F5C\u4E3A\u68C0\u504F\u5668\uFF1BQ \u7F6E\u4E8E\u6FC0\u5149\u5668\u4E0E
    P \u4E4B\u95F4\uFF0C\u65CB\u8F6C Q\uFF0C\u51FA\u73B0\u6D88\u5149\u73B0\u8C61\u65F6
    P \u4E0E Q \u504F\u632F\u65B9\u5411\u5782\u76F4\uFF0CQ \u4F5C\u4E3A\u8D77\u504F\u5668\u3002\r\n3\uFF09\u653E\u7F6E\u6676\u4F53\u548C\u6269\u675F\u955C\uFF0C\u5728\u767D\u5C4F\u4E0A\u89C2\u5BDF\u5230\u9525\u5149\u5E72\u6D89\u56FE\u50CF\u3002\u82E5\u56FE\u50CF\u4E0D\u5BF9\u79F0\uFF0C\u518D\u8FDB\u884C\u4F4D\u7F6E\u7684\u5FAE\u8C03\u3002\r\n\r\n<b>2.
    \u4EA4\u6D41\u8C03\u5236\u6CD5\u6D4B\u91CF\u534A\u6CE2\u7535\u538B</b>\r\n1\uFF09\u5728\u6676\u4F53\u4E0A\u53E0\u52A0\u7A33\u5B9A\u7684\u4EA4\u6D41\u8C03\u5236\u5C0F\u4FE1\u53F7\u3002\r\n2\uFF09\u7F13\u6162\u8C03\u8282\u9AD8\u538B\u76F4\u6D41\u7535\u6E90\u7684\u504F\u7F6E\u7535\u538B\uFF0C\u540C\u65F6\u4E25\u5BC6\u76D1\u89C6\u793A\u6CE2\u5668\u901A\u9053
    2 \u7684\u8F93\u51FA\u6CE2\u5F62\u3002\r\n3\uFF09\u5F53\u8F93\u51FA\u6CE2\u5F62\u7684\u57FA\u9891\u5F7B\u5E95\u6D88\u5931\u3001\u6CE2\u5F62\u5448\u73B0<b>\u5B8C\u5168\u5BF9\u79F0\u7684\u4E0A\u4E0B\u7FFB\u8F6C\u500D\u9891\u6CE2\u5F62</b>\u65F6\uFF0C\u8BF4\u660E\u5DE5\u4F5C\u70B9\u7CBE\u51C6\u8FBE\u5230\u4E86
    T-U \u66F2\u7EBF\u7684\u6CE2\u8C37\uFF0C\u8BB0\u5F55\u6B64\u65F6\u7684\u76F4\u6D41\u7535\u538B\u4E3A
    V0\u3002\r\n4\uFF09\u7EE7\u7EED\u6CBF\u540C\u4E00\u65B9\u5411\u8C03\u8282\u76F4\u6D41\u7535\u538B\uFF0C\u76F4\u5230\u793A\u6CE2\u5668\u4E0A\u518D\u6B21\u51FA\u73B0<b>\u5B8C\u7F8E\u7684\u3001\u5B8C\u5168\u5BF9\u79F0\u7684\u500D\u9891\u6CE2\u5F62</b>\uFF0C\u8BF4\u660E\u5DE5\u4F5C\u70B9\u7CBE\u51C6\u8FBE\u5230\u4E86\u66F2\u7EBF\u7684\u6CE2\u5CF0\uFF0C\u8BB0\u5F55\u6B64\u65F6\u7684\u76F4\u6D41\u7535\u538B\u4E3A
    V\u03C0\u3002\r\n5\uFF09\u7CBE\u51C6\u5B9A\u4F4D\u51FA\u7684\u4E24\u76F8\u90BB\u500D\u9891\u76F4\u6D41\u7535\u538B\u5DEE\u503C\uFF0C\u5373\u4E3A\u9AD8\u7CBE\u5EA6\u7684\u534A\u6CE2\u7535\u538B\uFF1A<b>V\u03C0
    = |V\u03C0 - V0|</b>\r\n\r\n<b>3. \u6781\u503C\u6CD5\u6D4B\u91CF\u534A\u6CE2\u7535\u538B</b>\r\n1\uFF09<b>\u539F\u7406\u4E0E\u6D4B\u91CF</b>\uFF1A\u901A\u8FC7\u7F13\u6162\u8C03\u8282\u76F4\u6D41\u7535\u6E90\u7535\u538B\uFF0C\u5229\u7528\u5149\u7535\u63A2\u6D4B\u5668\u7EC6\u81F4\u5BFB\u627E\u900F\u5149\u7387\u66F2\u7EBF\u7684\u6CE2\u5CF0\u4E0E\u6CE2\u8C37\u3002\u51C6\u786E\u8BB0\u5F55\u5149\u5F3A\uFF08\u6216\u900F\u5149\u7387\uFF09\u8FBE\u5230\u6781\u5927\u503C\u65F6\u5BF9\u5E94\u7684\u7535\u538B
    Vmax\uFF0C\u4EE5\u53CA\u76F8\u90BB\u6781\u5C0F\u503C\u65F6\u5BF9\u5E94\u7684\u7535\u538B
    Vmin\u3002\r\n2\uFF09<b>\u516C\u5F0F\u8BA1\u7B97</b>\uFF1A\u534A\u6CE2\u7535\u538B\u5728\u7269\u7406\u4E0A\u7B49\u4E8E\u5149\u7A0B\u5DEE\u6539\u53D8\u534A\u4E2A\u6CE2\u957F\u6240\u9700\u8981\u52A0\u7684\u5916\u52A0\u7535\u538B\u3002\u76F4\u63A5\u6D4B\u91CF\u4E24\u76F8\u90BB\u6781\u503C\u70B9\u5BF9\u5E94\u7684\u7535\u538B\u5DEE\u503C\uFF0C\u5373\u53EF\u5F97\u5230\u534A\u6CE2\u7535\u538B\uFF1A<b>V\u03C0
    = |Vmax - Vmin|</b>\r\n\r\n<b>\u4E94\u3001 \u6570\u636E\u5904\u7406\u4E0E\u5206\u6790</b>\r\n\u6839\u636E\u8BB0\u5F55\u7684\u6570\u636E\u7ED8\u5236\u7535\u5149\u6676\u4F53\u7684\u900F\u8FC7\u7387-\u7535\u538B\uFF08V-T\uFF09\u7279\u6027\u66F2\u7EBF\u3002\u4ECE\u66F2\u7EBF\u4E0A\u8BFB\u51FA\u6700\u5927\u900F\u5C04\u7387\u548C\u6700\u5C0F\u900F\u5C04\u7387\u5BF9\u5E94\u7684\u7535\u538B\u503C\uFF0C\u8BA1\u7B97\u8BE5\u6676\u4F53\u7684\u534A\u6CE2\u7535\u538B
    V\u03C0\u3002\r\n\u7ED3\u5408\u793A\u6CE2\u5668\u4E0A\u7684\u6CE2\u5F62\uFF0C\u5206\u6790\u76F4\u6D41\u504F\u7F6E\u70B9\u5BF9\u5149\u8C03\u5236\u8F93\u51FA\u6CE2\u5F62\uFF08\u7EBF\u6027\u6216\u500D\u9891\uFF09\u7684\u5F71\u54CD\u3002"
